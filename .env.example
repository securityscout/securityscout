# Required. Unset does not fall through to cursor.
#   anthropic — official Messages API
#   openai    — official Responses API
#   cursor    — cursor-agent CLI (`cursor-agent login`)
TRIAGE_MODEL_BACKEND=

# Vendor keys. Placeholders only; never commit a real key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Two-pass model assignment. Pass 1 and pass 2 must differ.
# Leave these unset so defaults follow TRIAGE_MODEL_BACKEND.
# Do not write empty assignments (TRIAGE_MODEL_PASS1=) — that
# is still set, and the backend column never applies.
# Cursor slugs are valid only when TRIAGE_MODEL_BACKEND=cursor.
# anthropic: claude-opus-5 / claude-sonnet-5 / claude-haiku-4-5
# openai:    gpt-6-astra / gpt-5.6-terra / gpt-5.6-luna
# cursor:    claude-opus-4-7-thinking-xhigh / claude-4.6-opus-high-thinking /
#            claude-opus-4-7-thinking-high

# ----- Worker pool -----------------------------------------------------------

TRIAGE_CONCURRENCY=4

# ----- Budget guardrails -----------------------------------------------------

# Monthly aggregate cap.
BUDGET_USD=200

# Per-finding ceiling. Intentionally equal to the monthly cap — a single
# finding is allowed to consume the full budget if a deep multi-pass
# investigation is warranted; the monthly aggregate is the real guard.
PER_FINDING_USD_CEILING=200

# ----- Privacy posture -------------------------------------------------------

# Honored by every git-touching component: triage never pushes, commits, or
# writes to any target repo. Setting to 0 disables this safety net (don't).
TRIAGE_READONLY_TARGET_REPOS=1

# ----- Ingest defaults -------------------------------------------------------

# Comma-separated fnmatch globs that ingest treats as default exclusions.
# Match against `repo_url` and `repository_name` of each SAST CSV
# row. Anything matching is inserted with `status='excluded'` so the worker
# pool skips it. Typical use: deliberately vulnerable test-fixture /
# playground corpora that would burn budget on synthetic findings.
# Leave blank to ingest every row by default.
# Example:
#   TRIAGE_DEFAULT_EXCLUDE_REPOS=*team-foo/test-fixtures*,*team-bar/sast-playground*
TRIAGE_DEFAULT_EXCLUDE_REPOS=

# ----- Access classification -------------------------------------------------

# Comma-separated list of hosts that `triage.classify_access` will probe
# via the live access API. A finding's repo is marked `no_access` only if
# the configured probe (see TRIAGE_ACCESS_PROBE below) explicitly answers
# "no". Repos on hosts NOT in this list cannot be probed at all, so their
# rows are left unchanged and reported at the end of the run.
#
# Empty by default: `glab` is the only probe implemented, so listing a
# host it cannot answer for would classify that host's repos against a
# probe that never runs. Add a host once its auth surface exists:
#   - gitlab.com           → `glab auth login --hostname gitlab.com`
#   - github.com           → needs a `gh` probe; not implemented yet
#   - bitbucket.org        → not implemented; would need an app password
TRIAGE_ACCESS_HOSTS=

# Probe strategy:
#   per_repo    (default) — one `glab api /projects/<encoded_path>` per unique
#               repo. Catches group-inherited access and namespace-rename
#               redirects. ~N HTTP calls where N = unique repos. Use this.
#   membership  — one paginated `/projects?membership=true` per host, then
#               set lookup. Cheap (1 call/host) but only sees DIRECT
#               membership; misses inheritance and redirects.
TRIAGE_ACCESS_PROBE=per_repo

# ----- Control-plane API -----------------------------------------------------

# Bearer token for every control-plane route except GET /health.
# Placeholder only; never commit a real token.
# Empty (or absent) means unset: `make serve` refuses to listen on
# anything but loopback, and local calls need no Authorization header.
TRIAGE_API_TOKEN=

# Listen address for `make serve` / `python -m api`. Empty uses the
# defaults below. Any non-loopback host (0.0.0.0, ::, a routable
# address) requires TRIAGE_API_TOKEN or the process exits before it
# binds. `make serve HOST=… PORT=…` exports into these for one run.
#   TRIAGE_API_HOST default: 127.0.0.1
#   TRIAGE_API_PORT default: 8000
TRIAGE_API_HOST=
TRIAGE_API_PORT=

# ----- SQLite ----------------------------------------------------------------

TRIAGE_DB_PATH=triage.db
